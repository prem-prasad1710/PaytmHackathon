# LLM provider: groq | grok | none
# Default resolution if LLM_PROVIDER unset: groq key → grok key → none
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — OpenAI-compatible
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# xAI Grok (optional alternative)
GROK_API_KEY=
GROK_MODEL=grok-4-latest
# GROK_API_URL=https://api.x.ai/v1/chat/completions

LLM_TIMEOUT_MS=12000
PORT=8787
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_ENABLED=true

# Hackathon laptop TLS workaround only — leave as-is unless Prem changes it
ALLOW_INSECURE_TLS=true
